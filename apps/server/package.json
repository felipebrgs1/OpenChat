{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "bun run --hot src/index.ts",
    "start": "bun run dist/index.mjs",
    "test": "bun test src/auth.test.ts src/chat.test.ts"
  },
  "dependencies": {
    "@nexo/contracts": "workspace:*",
    "@nexo/db": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.32",
    "jose": "^6.1.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nexo/config": "workspace:*",
    "@types/bun": "catalog:",
    "tsdown": "^0.22.14",
    "typescript": "catalog:"
  }
}
