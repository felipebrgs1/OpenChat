{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "bun run --hot src/index.ts",
    "worker": "bun run src/worker.ts",
    "start": "bun run dist/index.mjs",
    "test": "bun test src/auth.test.ts src/chat.test.ts src/knowledge.test.ts src/lib/acl.test.ts src/lib/ingestion.test.ts src/lib/storage.test.ts src/lib/pi-harness.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1124.0",
    "@aws-sdk/s3-request-presigner": "^3.1124.0",
    "@earendil-works/pi-ai": "^0.84.3",
    "@earendil-works/pi-coding-agent": "^0.84.3",
    "@nexo/contracts": "workspace:*",
    "@nexo/db": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.32",
    "jose": "^6.1.3",
    "mammoth": "^1.12.2",
    "pdf-parse": "^1.1.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nexo/config": "workspace:*",
    "@types/bun": "catalog:",
    "tsdown": "^0.22.14",
    "typescript": "catalog:"
  }
}
