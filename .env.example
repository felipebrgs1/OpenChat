NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://postgres:password@localhost:5434/nexo
POSTGRES_PASSWORD=password
VITE_SERVER_URL=http://localhost:3001
AUTH_DISABLED=true
VITE_AUTH_DISABLED=true

# Lote 1 — JWT
JWT_SECRET=troque-por-32-bytes-aleatorios
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BOOTSTRAP_ADMIN_EMAIL=admin@nexo.local
BOOTSTRAP_ADMIN_PASSWORD=troque-esta-senha

# Lote 2 — OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_HTTP_REFERER=http://localhost:5173
OPENROUTER_APP_TITLE=Nexo
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Lote 6 — RAG / Embeddings (pgvector 0.8.1 + Postgres 18)
EMBEDDING_MODEL=openai/text-embedding-3-small
# 1536 dims para text-embedding-3-small
