NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://postgres:password@localhost:5434/nexo
POSTGRES_PASSWORD=password
VITE_SERVER_URL=http://localhost:3001
AUTH_DISABLED=true
VITE_AUTH_DISABLED=true

# Lote 1 — JWT
JWT_SECRET=troque-por-32-bytes-aleatorios
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BOOTSTRAP_ADMIN_EMAIL=admin@nexo.local
BOOTSTRAP_ADMIN_PASSWORD=troque-esta-senha

# Lote 2 — OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_HTTP_REFERER=http://localhost:5173
OPENROUTER_APP_TITLE=Oráculo
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# R5/R6 — RAG / Embeddings (halfvec 2560) + Rerank
EMBEDDING_MODEL=perplexity/pplx-embed-v1-4b
EMBEDDING_DIMENSIONS=2560
RERANKER_MODEL=voyageai/rerank-2.5-lite
RERANKER_ENABLED=true
# Voyage via OpenRouter (recomendado) ou direto via VOYAGE_API_KEY
# VOYAGE_API_KEY= # opcional se usar OpenRouter para rerank
# COHERE_API_KEY= # fallback

# Storage de originais — RustFS (S3 compatível), padrão do sistema
# Dev: docker compose up rustfs (endpoint http://localhost:9000)
# Prod: RustFS em rede privada com TLS + service account de menor privilégio
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=nexo-private
S3_ACCESS_KEY=nexo
S3_SECRET_KEY=nexo12345
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# Cloudflare R2 — OPCIONAL, alternativa ao RustFS
# Com S3_* preenchido, o sistema usa RustFS; para forçar R2: STORAGE_DRIVER=r2
# R2_ACCOUNT_ID= # gera endpoint https://<account_id>.r2.cloudflarestorage.com
# R2_ENDPOINT= # opcional, sobrepõe o endpoint derivado do account id
# R2_BUCKET=nexo-private
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# STORAGE_DRIVER= # local | rustfs | r2 (default: auto — rustfs → r2 → disco local)

STORAGE_DIR=./data/storage
MAX_UPLOAD_BYTES=52428800
# 50 MB default

# R3 — Docling worker (extração estruturada) + OCR opcional
# Dev: fallback local funciona sem worker; worker sobe com docker compose --profile docling up docling-worker
DOCLING_WORKER_URL=http://localhost:8001
OCR_ENABLED=false
# OCR só para PDFs escaneados; se qualidade mínima não for atingida, ingestão falha e exige revisão manual
